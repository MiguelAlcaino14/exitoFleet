# Base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# AWS S3 / DigitalOcean Spaces (almacenamiento de fotos)
AWS_REGION=
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Solo para DigitalOcean Spaces (omitir si se usa AWS S3 nativo)
AWS_ENDPOINT=

# MailerSend (envío de correos)
MAILERSEND_API_KEY=
MAILERSEND_FROM_EMAIL=
